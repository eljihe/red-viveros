<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o directorio solicitado existe físicamente
    # (css, js, uploads, etc.), se sirve directamente.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Cualquier otra ruta pasa por el front controller.
    RewriteRule ^ index.php [L]
</IfModule>
